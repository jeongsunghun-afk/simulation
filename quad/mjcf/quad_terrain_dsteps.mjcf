<mujoco model="terrain_dsteps">
  <!-- 떨어진 디딤돌(사이 갭 ~0.18m) + 높이차(0.06~0.16). 갭회피+base협조 동시 요구. -->
  <include file="quad_real_16dof_sphere.mjcf"/>
  <worldbody>
    <geom name="ds_start" type="box" group="2" size="0.55 0.7 0.10" pos="-0.05 0 -0.10" rgba="0.48 0.54 0.64 1"/>
    <!-- 디딤돌 hw=0.11, 간격 0.40(갭 ~0.18), 높이 top 0.06/0.12/0.16/0.10/0.06 -->
    <geom name="ds1" type="box" group="2" size="0.11 0.7 0.10" pos="0.70 0 -0.04" rgba="0.40 0.60 0.50 1"/>
    <geom name="ds2" type="box" group="2" size="0.11 0.7 0.10" pos="1.10 0 0.02"  rgba="0.42 0.58 0.52 1"/>
    <geom name="ds3" type="box" group="2" size="0.11 0.7 0.10" pos="1.50 0 0.06"  rgba="0.44 0.56 0.54 1"/>
    <geom name="ds4" type="box" group="2" size="0.11 0.7 0.10" pos="1.90 0 0.00"  rgba="0.42 0.58 0.52 1"/>
    <geom name="ds5" type="box" group="2" size="0.11 0.7 0.10" pos="2.30 0 -0.04" rgba="0.40 0.60 0.50 1"/>
    <geom name="ds_end" type="box" group="2" size="0.7 0.7 0.10" pos="3.2 0 -0.10" rgba="0.48 0.54 0.64 1"/>
  </worldbody>
</mujoco>
