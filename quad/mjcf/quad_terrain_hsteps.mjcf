<mujoco model="terrain_hsteps">
  <!-- 높이 varying 디딤돌 라인(y=0). base-발판 협조 없으면 못 디딤(A 실패 예상). -->
  <include file="quad_real_16dof_sphere.mjcf"/>
  <worldbody>
    <!-- 시작 발판(로봇 스폰, top z=0) -->
    <geom name="hs_start" type="box" group="2" size="0.55 0.7 0.10" pos="-0.05 0 -0.10" rgba="0.48 0.54 0.64 1"/>
    <!-- 디딤돌: 높이 0.06→0.12→0.16→0.12→0.06 (계단식 언덕, base pitch/z 협조 요구) -->
    <geom name="hs1" type="box" group="2" size="0.16 0.7 0.10" pos="0.66 0 -0.04"  rgba="0.40 0.60 0.50 1"/>
    <geom name="hs2" type="box" group="2" size="0.16 0.7 0.10" pos="0.98 0 0.02"   rgba="0.42 0.58 0.52 1"/>
    <geom name="hs3" type="box" group="2" size="0.16 0.7 0.10" pos="1.30 0 0.06"   rgba="0.44 0.56 0.54 1"/>
    <geom name="hs4" type="box" group="2" size="0.16 0.7 0.10" pos="1.62 0 0.02"   rgba="0.42 0.58 0.52 1"/>
    <geom name="hs5" type="box" group="2" size="0.16 0.7 0.10" pos="1.94 0 -0.04"  rgba="0.40 0.60 0.50 1"/>
    <!-- 끝 발판(top z=0) -->
    <geom name="hs_end" type="box" group="2" size="0.7 0.7 0.10" pos="2.9 0 -0.10" rgba="0.48 0.54 0.64 1"/>
  </worldbody>
</mujoco>
